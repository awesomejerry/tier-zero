# Mock mode needs none of these. The dashboard and `pnpm benchmark` run on the
# heuristic provider unless you opt into a live run.

# Required only for `pnpm benchmark --live` and the OpenAI adapters.
OPENAI_API_KEY=

# Decisions model. gpt-6-luna is the only model the Decisions API currently supports.
OPENAI_DECISIONS_MODEL=gpt-6-luna

# System Two model. Tool use goes through the Responses API.
OPENAI_AGENT_MODEL=gpt-6.2-sol

# Optional override, including an Azure or proxy origin, with no trailing path.
OPENAI_BASE_URL=https://api.openai.com

# Provider selection for the benchmark CLI: mock | openai
TIER_ZERO_PROVIDER=mock

# TypeSafe Jev is early access. There is no key to set until the adapter is filled in.
# See packages/providers/src/jev.ts.
